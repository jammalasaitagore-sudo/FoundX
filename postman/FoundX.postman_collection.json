    {
      "name": "2. Authentication (success)",
      "item": [
        {
          "name": "Login - valid credentials (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns an access token', () => pm.expect(body.data.access_token).to.be.a('string'));",
                  "pm.test('returns the user profile', () => pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('userEmail')));",
                  "if (body.data.access_token) { pm.collectionVariables.set('accessToken', body.data.access_token); }",
                  "if (body.data.refresh_token) { pm.collectionVariables.set('refreshToken', body.data.refresh_token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Run this first. The test script stores the token in the collection variable `accessToken`."
          }
        },
        {
          "name": "Get my profile (protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const user = pm.response.json().data.user;",
                  "pm.test('returns my email', () => pm.expect(user.email).to.eql(pm.collectionVariables.get('userEmail')));",
                  "pm.test('role is student', () => pm.expect(user.role).to.eql('student'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Update my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const user = pm.response.json().data.user;",
                  "pm.test('phone was updated', () => pm.expect(user.phone).to.eql('+91 98765 43210'));",
                  "pm.test('role is still student (cannot self-promote)', () => pm.expect(user.role).to.eql('student'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
