    {
      "name": "1. Health & index",
      "item": [
        {
          "name": "Health check - service and database",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('success flag is true', () => pm.expect(body.success).to.eql(true));",
                  "pm.test('database is connected', () => pm.expect(body.data.database).to.eql('connected'));",
                  "pm.test('responds within 5 seconds', () => pm.expect(body.data.latency_ms).to.be.below(5000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Returns the API status and whether Supabase Postgres is reachable."
          }
        },
        {
          "name": "API index - list of endpoints",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns endpoint map', () => pm.expect(pm.response.json().endpoints).to.be.an('object'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api"
              ]
            }
          }
        }
      ]
