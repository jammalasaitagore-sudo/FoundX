                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data;",
                  "pm.test('all results are found items', () => {",
                  "  body.items.forEach((item) => pm.expect(item.listing_type).to.eql('found'));",
                  "});",
                  "pm.test('all results are in the Central Library', () => {",
                  "  body.items.forEach((item) => pm.expect(item.campus_building).to.eql('Central Library'));",
                  "});",
                  "pm.test('results are sorted by event_date descending', () => {",
                  "  const dates = body.items.map((i) => i.event_date);",
