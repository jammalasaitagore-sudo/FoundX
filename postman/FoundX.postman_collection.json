            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+91 98765 43210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "Register a new user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('profile created with the submitted name', () => pm.expect(body.data.user.full_name).to.eql('Postman Tester'));",
                  "pm.test('new users get the student role', () => pm.expect(body.data.user.role).to.eql('student'));",
                  "pm.collectionVariables.set('newUserEmail', body.data.user.email);"
                ]
