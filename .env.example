# ---------------------------------------------------------------
# FoundX - environment variables
# Copy this file to .env and fill in the values from your
# Supabase dashboard: Project Settings -> API / Database.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

# Server
PORT=4000
NODE_ENV=development

# Comma separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Supabase project URL, e.g. https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# Project Settings -> API -> Project API keys -> "anon" / "public"
SUPABASE_ANON_KEY=

# Project Settings -> API -> Project API keys -> "service_role" (SECRET!)
# Used only on the server. It bypasses Row Level Security, so it must
# never be exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket that holds item photos (create it with the SQL migration)
SUPABASE_STORAGE_BUCKET=item-images

# Max upload size for item images, in megabytes
MAX_UPLOAD_MB=5
